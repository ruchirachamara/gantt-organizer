PORT=3001

# Public web app origin(s), comma-separated for prod + localhost
# Local web defaults to :3010 (port 3000 is often used by Grafana etc.)
FRONTEND_ORIGIN=http://localhost:3010
# FRONTEND_ORIGINS=http://localhost:3010,https://your-app.example.com

# Public base URL of this API (used to build OAuth redirect URIs)
API_PUBLIC_URL=http://localhost:3001
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# Prefer the web origin + /api proxy so the callback matches the public app URL
LINKEDIN_REDIRECT_URI=http://localhost:3010/api/auth/linkedin/callback

# Google Cloud Console → OAuth 2.0 Web client
# Authorized redirect URIs must include GOOGLE_REDIRECT_URI (local + production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn Developer Portal → Auth → OAuth 2.0
# Authorized redirect URLs must include LINKEDIN_REDIRECT_URI (local + production)
# Products: enable "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Random secret for signing app session JWTs (min 16 chars)
JWT_SECRET=

ALLOW_GUEST_TIMELINES=false

COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=gantt
COSMOS_CONTAINER=timelines
