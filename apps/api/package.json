{
  "name": "@gantt/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for Gantt timeline Cosmos CRUD",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "start:dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "start:watch": "node --watch -r ts-node/register/transpile-only src/main.ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
