# Gemini (optional AI assistant)
GEMINI_API_KEY=
NEXT_PUBLIC_FALLBACK_MODELS=

# Nest API via same-origin rewrite (/api/auth/*, /api/timelines/* → Nest)
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://localhost:3001

# Google OAuth Web client ID (same as API GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# LinkedIn OAuth client ID (same as API LINKEDIN_CLIENT_ID)
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
